# Copia este archivo como .env y rellena los valores.

# Dominio del panel (ej. panel.tudominio.com). Déjalo en :80 para probar por IP sin HTTPS.
DOMAIN=:80

# Genera valores aleatorios con:  openssl rand -hex 32
DB_PASSWORD=
SESSION_SECRET=

# Administrador inicial: solo se usa la primera vez, cuando no existe ningún usuario.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
